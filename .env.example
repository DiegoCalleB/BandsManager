# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Agente Enviador/Lector (server/services/emailAgentClient.ts): cada banda conecta su propia
# cuenta de email por SMTP/IMAP con una contraseña de aplicación, no por variables de entorno
# globales - las credenciales se guardan por banda en Supabase (band_email_accounts), no aquí.

# AGENT_EMAIL_MODE: 'draft' (por defecto) o 'send'.
#   draft -> el Agente Enviador NUNCA envía: deja cada propuesta como borrador en la bandeja de
#            la banda para revisar redacción y formato, y marca el lead como 'borrador_creado'.
#   send  -> envío real por SMTP al destinatario.
# Seguro por defecto: si esta variable falta o tiene cualquier otro valor, NO se envía nada.
# Mientras el sistema esté en pruebas, déjala sin definir o en 'draft'.
AGENT_EMAIL_MODE=draft

# CRON_SECRET: secreto compartido para llamadas internas autenticadas sin sesión de usuario
# (requireCronOrAuth) - lo usa, entre otros, el trigger de Postgres que dispara el envío
# inmediato de respuestas aprobadas (ver supabase/postgres_trigger_respuesta_inmediata.sql).
# También firma el parámetro "state" del flujo de Gmail OAuth (server/routes/gmailOAuth.ts).
CRON_SECRET=

# GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET / GOOGLE_OAUTH_REDIRECT_URI: OAuth
# "offline" de Gmail por banda (server/routes/gmailOAuth.ts, server/services/gmailApiClient.ts)
# - permite que el Agente Enviador cree borradores en Gmail sin contraseña de aplicación NI
# popup, incluido desde el scheduler (que corre sin navegador). Distinto del Client ID que ya
# usa Firebase Auth para el popup del Chatbot (firebase-applet-config.json): este necesita su
# propio Client ID de tipo "Web application" en Google Cloud Console, porque hace falta el
# client_secret para el intercambio de tokens servidor-a-servidor, y Firebase no lo expone.
# Pasos en https://console.cloud.google.com/apis/credentials (proyecto de Firebase):
#   1. Crear credencial OAuth 2.0 de tipo "Web application".
#   2. Añadir como "Authorized redirect URI" exactamente el valor de GOOGLE_OAUTH_REDIRECT_URI
#      (debe apuntar a /api/gmail-oauth/callback en este mismo servidor).
#   3. Confirmar que la Gmail API está habilitada y que la pantalla de consentimiento incluye
#      los scopes https://www.googleapis.com/auth/gmail.compose (borradores/envío) y
#      https://www.googleapis.com/auth/gmail.modify (leer la bandeja y marcar como leído, lo
#      que usa el Agente Lector - server/routes/gmailOAuth.ts).
# Sin estas tres variables, el Agente Enviador sigue funcionando igual que antes (SMTP/IMAP con
# contraseña de aplicación, band_email_accounts) - esto es una vía adicional, no un reemplazo.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# RESEND_API_KEY: Clave de la API de Resend (https://resend.com) para el envío real
# de correos transaccionales y notificaciones del sistema (no-reply@bandmanager.io).
# Sin esta clave, el sistema funciona en modo simulación (logs en consola).
RESEND_API_KEY=

# RESEND_WEBHOOK_SECRET: Signing secret opcional (whsec_...) para webhooks de Resend (/api/webhooks/resend).
RESEND_WEBHOOK_SECRET=

# SENDER_EMAIL: Remitente de los correos transaccionales (por defecto: BandManager <no-reply@bandmanager.io>).
SENDER_EMAIL=BandManager <no-reply@bandmanager.io>

# OPENAI_API_KEY: Required for OpenAI Whisper-1 transcription services.
OPENAI_API_KEY=

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key to query channel metrics dynamically for any band.
YOUTUBE_API_KEY=

# SUPABASE_URL: Supabase project URL for database and storage.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: Key to authenticate with Supabase.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# GOOGLE_PLACES_API_KEY: Optional key for Google Places API venue discovery.
GOOGLE_PLACES_API_KEY=

# SUPABASE_STORAGE_BUCKET: Bucket name for audio and image files (defaults to 'band-media').
SUPABASE_STORAGE_BUCKET=band-media

# STRIPE_SECRET_KEY: Stripe Secret Key for subscription checkout and payments (Test/Live)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Stripe Webhook Secret for signature verification.
# Shared by /api/billing/webhook and the "ai_donation" checkout.session.completed
# branch it handles for server/routes/donations.ts (see AGENTS.md / CLAUDE.md) -
# donations don't get a second webhook endpoint or secret of their own.
STRIPE_WEBHOOK_SECRET=

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Optional official Spotify Developer API credentials.
# (If not provided, the app uses official public client token resolution).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# SERPER_API_KEY: Optional Serper.dev Google Search API key for real-time live venue & festival programming radar.
SERPER_API_KEY=

# DEEPSEEK_API_KEY: Required for DeepSeek V3 / R1 models.
DEEPSEEK_API_KEY=



# REPLICATE_API_TOKEN: Optional API key for Replicate to run Deep Learning Music Source Separation
# models like Demucs v4 (HT-Demucs), Mel-Band RoFormer and BS-RoFormer on dedicated GPUs (produces studio Moises-grade isolated stems).
REPLICATE_API_TOKEN=

# REPLICATE_WEBHOOK_SECRET: Optional webhook signing secret (whsec_...) from Replicate to verify webhook authenticity.
REPLICATE_WEBHOOK_SECRET=

# FAL_KEY: Optional API key for Fal.ai high-speed neural audio stem separation.
FAL_KEY=

# TICKETMASTER_API_KEY: Optional key for Ticketmaster Discovery API v2 (Salas, Arenas y Festivales a nivel mundial y España).
TICKETMASTER_API_KEY=

# SETLISTFM_API_KEY: Optional key for Setlist.fm REST API v2 (Histórico de salas por conciertos reales y artistas similares).
SETLISTFM_API_KEY=

# EVENTBRITE_API_KEY: Optional key for Eventbrite API v3 (Eventos independientes, ciclos culturales y festivales emergentes).
EVENTBRITE_API_KEY=

# SENTRY_DSN / VITE_SENTRY_DSN: Data Source Name para captura de excepciones y errores en Sentry (https://sentry.io).
#   SENTRY_DSN -> Para el backend (Node.js/Express, server/utils/errorTracking.ts).
#   VITE_SENTRY_DSN -> Para el cliente/navegador del usuario (React, src/utils/errorTracking.ts).
# Si falta la variable correspondiente, el rastreo se deshabilita pasivamente sin afectar a la app.
SENTRY_DSN=
VITE_SENTRY_DSN=


