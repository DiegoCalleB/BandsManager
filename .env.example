# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GITHUB_PAT: Personal Access Token with 'repo' or 'workflow' / 'actions:write' permissions to trigger GitHub Actions.
GITHUB_PAT=



# GITHUB_REPO_OWNER: Owner of the repository containing the agents.
GITHUB_REPO_OWNER=DiegoCalleB

# GITHUB_REPO_NAME: Name of the repository containing the agents.
GITHUB_REPO_NAME=bakandeya-agent-manager

# OPENAI_API_KEY: Required for OpenAI Whisper-1 transcription services.
OPENAI_API_KEY=

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key to query channel metrics dynamically for any band.
YOUTUBE_API_KEY=

# SUPABASE_URL: Supabase project URL for database and storage.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: Key to authenticate with Supabase.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# GOOGLE_PLACES_API_KEY: Optional key for Google Places API venue discovery.
GOOGLE_PLACES_API_KEY=

# SUPABASE_STORAGE_BUCKET: Bucket name for audio and image files (defaults to 'band-media').
SUPABASE_STORAGE_BUCKET=band-media

# STRIPE_SECRET_KEY: Stripe Secret Key for subscription checkout and payments (Test/Live)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Stripe Webhook Secret for signature verification
STRIPE_WEBHOOK_SECRET=

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Optional official Spotify Developer API credentials.
# (If not provided, the app uses official public client token resolution).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ANTHROPIC_API_KEY: Required for Claude 3.5 Haiku / Sonnet models.
ANTHROPIC_API_KEY=

# DEEPSEEK_API_KEY: Required for DeepSeek V3 / R1 models.
DEEPSEEK_API_KEY=
