# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Agente Enviador/Lector (server/services/emailAgentClient.ts): cada banda conecta su propia
# cuenta de email por SMTP/IMAP con una contraseña de aplicación, no por variables de entorno
# globales - las credenciales se guardan por banda en Supabase (band_email_accounts), no aquí.

# AGENT_EMAIL_MODE: 'draft' (por defecto) o 'send'.
#   draft -> el Agente Enviador NUNCA envía: deja cada propuesta como borrador en la bandeja de
#            la banda para revisar redacción y formato, y marca el lead como 'borrador_creado'.
#   send  -> envío real por SMTP al destinatario.
# Seguro por defecto: si esta variable falta o tiene cualquier otro valor, NO se envía nada.
# Mientras el sistema esté en pruebas, déjala sin definir o en 'draft'.
AGENT_EMAIL_MODE=draft

# CRON_SECRET: secreto compartido para llamadas internas autenticadas sin sesión de usuario
# (requireCronOrAuth) - lo usa, entre otros, el trigger de Postgres que dispara el envío
# inmediato de respuestas aprobadas (ver supabase/postgres_trigger_respuesta_inmediata.sql).
CRON_SECRET=

# OPENAI_API_KEY: Required for OpenAI Whisper-1 transcription services.
OPENAI_API_KEY=

# YOUTUBE_API_KEY: Optional YouTube Data API v3 key to query channel metrics dynamically for any band.
YOUTUBE_API_KEY=

# SUPABASE_URL: Supabase project URL for database and storage.
SUPABASE_URL=

# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_ANON_KEY: Key to authenticate with Supabase.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# GOOGLE_PLACES_API_KEY: Optional key for Google Places API venue discovery.
GOOGLE_PLACES_API_KEY=

# SUPABASE_STORAGE_BUCKET: Bucket name for audio and image files (defaults to 'band-media').
SUPABASE_STORAGE_BUCKET=band-media

# STRIPE_SECRET_KEY: Stripe Secret Key for subscription checkout and payments (Test/Live)
STRIPE_SECRET_KEY=

# STRIPE_WEBHOOK_SECRET: Stripe Webhook Secret for signature verification
STRIPE_WEBHOOK_SECRET=

# SPOTIFY_CLIENT_ID & SPOTIFY_CLIENT_SECRET: Optional official Spotify Developer API credentials.
# (If not provided, the app uses official public client token resolution).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ANTHROPIC_API_KEY: Required for Claude 3.5 Haiku / Sonnet models.
ANTHROPIC_API_KEY=

# DEEPSEEK_API_KEY: Required for DeepSeek V3 / R1 models.
DEEPSEEK_API_KEY=
