{
  "name": "bandmanager-ai",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Diego de la Calle Berzal",
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && BUILDING=true NODE_OPTIONS=--max-old-space-size=1536 vite build && BUILDING=true esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs && BUILDING=true esbuild scripts/migrate.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/migrate.cjs",
    "start": "node dist/migrate.cjs && node dist/server.cjs",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('server.js',{force:true});\"",
    "lint": "esbuild server.ts src/main.tsx --bundle --platform=node --packages=external --outdir=dist/test-lint && node -e \"require('fs').rmSync('dist/test-lint', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:fast": "vitest run --passWithNoTests",
    "test:security": "vitest run server/db/__tests__/bandIdTrustBoundary.test.ts",
    "check:fast": "npm run typecheck && npm run test:security",
    "check:all": "node scripts/check-all.mjs",
    "graph:sync": "tsx scripts/generate_obsidian_graph.ts",
    "spotify:bandas": "tsx scripts/arreglar-spotify-bandas.ts",
    "probar:senales": "tsx scripts/probar-senales.ts",
    "cartel:muestras": "tsx scripts/muestras-cartel.ts",
    "probar:publicacion": "tsx scripts/probar-publicacion.ts",
    "banco:deteccion": "tsx scripts/banco-deteccion.ts",
    "test:coverage": "vitest run --coverage",
    "coverage:ratchet": "node scripts/subir-umbral-cobertura.mjs",
    "test:e2e": "playwright test",
    "lint:eslint": "eslint .",
    "verify:tamano": "node scripts/tamano-ficheros.mjs",
    "verify:docs": "node scripts/tamano-ficheros.mjs && node scripts/verify-docs-refs.cjs && node scripts/sync-skills.mjs --check && node scripts/generate-openapi.mjs --check && node scripts/verify-docs-consistencia.cjs",
    "docs:api": "node scripts/generate-openapi.mjs",
    "skills:sync": "node scripts/sync-skills.mjs",
    "docs:metricas": "node scripts/verify-docs-consistencia.cjs --fix",
    "prepare": "husky || exit 0",
    "design:audit": "node scripts/design-audit.js",
    "design:audit:strict": "node scripts/design-audit.js --strict",
    "design:fix": "node scripts/design-fixer.js && npm run typecheck && npm run build",
    "audit:paleta": "python3 scripts/paleta-audit.py",
    "audit:emojis": "node scripts/emojis-ui.mjs",
    "audit:contraste": "node scripts/contraste-clases.mjs",
    "audit:diseno": "node scripts/design-audit.js && node scripts/superficies-check.mjs && node scripts/emojis-ui.mjs && node scripts/contraste-clases.mjs && python3 scripts/paleta-audit.py",
    "audit:guardado": "vitest run server/audit",
    "audit:clases": "vitest run src/audit",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:check": "tsx scripts/migrate.ts --check",
    "check:modelos": "tsx scripts/check-modelos-ia.ts",
    "eval:acordes": "tsx scripts/evaluar-acordes.ts",
    "benchmark:acordes": "tsx scripts/benchmark-acordes.ts",
    "benchmark:exportar": "tsx scripts/exportar-benchmark.ts",
    "eval:agentes": "tsx scripts/evaluar-agentes.ts",
    "catalogo:salas": "tsx scripts/catalogo-salas.ts",
    "festivales:cargar": "tsx scripts/festivales-cargar.ts",
    "verify:ciclos": "node scripts/ciclos.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@sentry/node": "^10.73.0",
    "@sentry/react": "^10.75.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.16.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.7.1",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.17",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^10.1.0",
    "onnxruntime-node": "^1.30.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "resend": "^6.27.0",
    "soundtouchjs": "^0.3.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.7.0",
    "tone": "^15.1.22",
    "vexflow": "5.0.0",
    "wavesurfer.js": "^7.12.11",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.3",
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "happy-dom": "^20.14.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "madge": "^8.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "eslint --fix",
    "src/**/*.{ts,tsx,css}": "node scripts/design-audit.js",
    "{AGENTS,CLAUDE,docs/referencia/TOOL_COMPATIBILITY,docs/referencia/AI_STUDIO_SUPABASE_GUIDE}.md": "node scripts/verify-docs-refs.cjs",
    "skills/**/*.md": "node scripts/verify-docs-refs.cjs"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6"
  }
}
