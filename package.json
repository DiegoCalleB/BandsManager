{
  "name": "bandmanager-ai",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Diego de la Calle Berzal",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && BUILDING=true NODE_OPTIONS=--max-old-space-size=1536 vite build && BUILDING=true esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('server.js',{force:true});\"",
    "lint": "esbuild server.ts src/main.tsx --bundle --platform=node --packages=external --outdir=dist/test-lint && node -e \"require('fs').rmSync('dist/test-lint', { recursive: true, force: true })\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint:eslint": "eslint .",
    "verify:docs": "node scripts/verify-docs-refs.cjs",
    "prepare": "husky || exit 0"
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.12",
    "@google/genai": "^2.4.0",
    "@sentry/node": "^10.73.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.16.0",
    "fluent-ffmpeg": "^2.1.3",
    "helmet": "^8.3.0",
    "html2canvas": "^1.4.1",
    "imapflow": "^1.7.1",
    "jszip": "^3.10.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^0.546.0",
    "mailparser": "^3.9.17",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-qr-code": "^2.2.0",
    "recharts": "^3.9.2",
    "resend": "^6.27.0",
    "soundtouchjs": "^0.3.0",
    "stripe": "^22.5.0",
    "tone": "^15.1.22",
    "wavesurfer.js": "^7.12.11",
    "xlsx": "npm:@e965/xlsx@^0.20.3",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/express": "^4.17.21",
    "@types/leaflet": "^1.9.22",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": "eslint --fix",
    "{AGENTS,CLAUDE,TOOL_COMPATIBILITY,AI_STUDIO_SUPABASE_GUIDE}.md": "node scripts/verify-docs-refs.cjs",
    "skills/**/*.md": "node scripts/verify-docs-refs.cjs"
  }
}
